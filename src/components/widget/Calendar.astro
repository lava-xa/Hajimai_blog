---
import { getSortedPosts } from "../../utils/content-utils";
import CalendarWidget from "./Calendar.svelte";
import WidgetLayout from "./WidgetLayout.astro";

interface Props {
	class?: string;
	style?: string;
}

const { class: className, style } = Astro.props;
const posts = (await getSortedPosts()).map((post) => {
	const published = post.data.published;
	return {
		slug: post.slug,
		title: post.data.title,
		date: [
			published.getFullYear(),
			String(published.getMonth() + 1).padStart(2, "0"),
			String(published.getDate()).padStart(2, "0"),
		].join("-"),
	};
});
---

<WidgetLayout id="calendar-widget" class={className} style={style}>
	<CalendarWidget client:only="svelte" {posts} />
</WidgetLayout>
